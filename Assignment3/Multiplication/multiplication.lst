     1                                  ; multiplication.asm
     2                                  ; unsigned int num1 = 300000, num2 = 400000
     3                                  ; unsigned long product = 0
     4                                  ; product = long (num1 * num2)
     5                                  
     6                                  section .data
     7                                      SYS_exit        equ 60
     8                                      EXIT_SUCCESS    equ 0
     9                                  
    10 00000000 E0930400                    num1            dd 300000          ; 0x000493E0
    11 00000004 801A0600                    num2            dd 400000          ; 0x00061A80
    12 00000008 0000000000000000            product         dq 0               ; 64-bit product
    13                                  
    14                                  section .text
    15                                      global _start
    16                                  _start:
    17                                      ; edx:eax = eax * [num2]  (unsigned 32 x 32 -> 64)
    18 00000000 BA00000000                  mov     edx, 0                     ; Clear edx before multiplication
    19 00000005 8B0425[00000000]            mov     eax, dword [num1]          ; eax = num1
    20 0000000C F72425[04000000]            mul     dword [num2]               ; edx:eax = eax * [num2]
    21                                  
    22 00000013 890425[08000000]            mov     dword [product], eax       ; low  32 bits 
    23 0000001A 891425[0C000000]            mov     dword [product+4], edx     ; high 32 bits
    24                                  
    25                                      ; exit
    26 00000021 B83C000000                  mov     rax, SYS_exit
    27 00000026 BF00000000                  mov     rdi, EXIT_SUCCESS
    28 0000002B 0F05                        syscall
