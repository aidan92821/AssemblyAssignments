     1                                  ;exam01_review.asm
     2                                  ;signed char num1 = 50; //8-bit signed vairable
     3                                  ;signed char num2 = -30; //8-bit signed vairable
     4                                  ;signed char num3 = -23; //8-bit signed vairable
     5                                  ;signed short product = 0 //16-bit signed vairable
     6                                  ;signed char quotient = 0; //8-bit signed vairable
     7                                  ;signed char remainder = 0; //8-bit signed vairable
     8                                  ;product = num1 * num2;
     9                                  ;quotient = product / num3;
    10                                  ;remainder = product % num3;
    11                                  
    12                                  section .data
    13 00000000 32                          num1        db  50      ;num1 = 0x32
    14 00000001 E2                          num2        db  -30     ;num2 = 0xE2
    15 00000002 E9                          num3        db  -23     ;num3 = 0xE9
    16 00000003 0000                        product     dw  0       ;product = 0x0000
    17 00000005 00                          quotient    db  0       ;quotient = 0x00
    18 00000006 00                          remainder   db  0       ;remainder = 0x00
    19                                  
    20                                  section .text
    21                                      global _start
    22                                  
    23                                  _start:
    24 00000000 8A0425[00000000]            mov     al, byte[num1]          ;al = num1 = 0x32
    25 00000007 F62C25[01000000]            imul    byte[num2]              ;ax = al*num2 = 0x32*0xE2 = 0xFA24
    26 0000000E 66890425[03000000]          mov     word[product], ax       ;product = ax = 0xFA24 = -1500
    27 00000016 F63C25[02000000]            idiv    byte[num3]              ;ah=ax%num3=0xFB, al=ax/num3=0x41
    28 0000001D 880425[05000000]            mov     byte[quotient], al      ;quotient = al = 0x41 = 65
    29 00000024 882425[06000000]            mov     byte[remainder], ah     ;remainder = ah = 0xFB = -5
    30                                  _stop:
    31 0000002B B83C000000                  mov     rax, 60                 ;terminate excuting process
    32 00000030 BF00000000                  mov     rdi, 0                  ;exit status
    33 00000035 0F05                        syscall
